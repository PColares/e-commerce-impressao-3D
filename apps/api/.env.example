# MySQL — é o banco gerenciado do plano da Hostinger (Postgres só em VPS).
# Local: o docker-compose.dev.yml publica o MySQL na porta 3307.
# Produção: use os dados do banco criado no hPanel, sem as aspas ao colar no painel.
DATABASE_URL="mysql://usuario:senha@host:3306/nome_do_banco"
REDIS_URL="redis://localhost:6379"
# Gere um valor forte e único; o segredo do JWT é o que impede tokens forjados:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="gere-um-valor-aleatorio-forte"
PORT=3333
